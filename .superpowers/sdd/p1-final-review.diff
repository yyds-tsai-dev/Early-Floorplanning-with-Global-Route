+    }
+    return fit;
+}
+
+OutlineFit shrinkWrapOutline(const Problem& problem, Placement& placement, int max_grow_steps) {
+    double w_lb = 0.0;
+    double h_lb = 0.0;
+    lowerBoundNeeds(problem, placement, &w_lb, &h_lb);
