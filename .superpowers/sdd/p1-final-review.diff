+    scoped.outline_w = w;
+    scoped.outline_h = h;
+    for (std::size_t i = 0; i < problem.blocks.size(); ++i) {
+        if (!isEdge(problem.blocks[i].type)) continue;
+        if (!edgeRectLegal(scoped, problem.blocks[i], placement.rects[i])) return false;
+    }
+    return true;
