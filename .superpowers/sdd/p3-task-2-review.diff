+        StripDemand d1;
+        d1.left = 0;
+        d1.right = 1;
+        d1.need_w = 15.0;
+        StripDemand d2;
+        d2.left = 2;
+        d2.right = 3;
+        d2.need_w = 200.0;
+        demand_sets.push_back({d1, d2});
+    }
+    {
+        StripDemand d1;
+        d1.left = 1;
+        d1.right = 2;
+        d1.need_w = 3.0;
+        demand_sets.push_back({d1});
+    }
+    {
+        StripDemand d1;
+        d1.left = 0;
+        d1.right = 1;
+        d1.need_w = 500.0;
+        StripDemand d2;
+        d2.left = 1;
+        d2.right = 2;
+        d2.need_w = 500.0;
+        StripDemand d3;
+        d3.left = 2;
+        d3.right = 3;
+        d3.need_w = 500.0;
+        demand_sets.push_back({d1, d2, d3});
+    }
+    demand_sets.push_back({});  // empty demand set: pure no-op
+
+    for (const auto& demands : demand_sets) {
+        auto [p, pl0] = makeRow();
+        Placement pl = pl0;
+        bool changed = relaxToDemand(p, pl, demands);
+        assert(changed);
+        for (int i = 0; i + 1 < 4; ++i) {
+            assert(pl.rects[i].x + kEps < pl.rects[i + 1].x);
+        }
+        for (const auto& r : pl.rects) {
+            assert(r.right() <= p.outline_w + kEps);
+        }
+    }
+    std::cout << "testOrderFreezeUnderVariedDemands ok\n";
+}
