+            {"CH4", 1000.0}, {"CH6", 1000.0}, {"CH8", 500.0}, {"CH10", 5800.0}, {"CH11", 4800.0}};
+        const std::pair<const char*, double> demand_v[] = {
+            {"CH8", 2300.0}, {"CH10", 1400.0}, {"CH11", 200.0}};
