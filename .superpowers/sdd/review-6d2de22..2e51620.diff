+// Moved verbatim from routing.cpp:24.
+inline int edgeFromTo(const Rect& a, const Rect& b) {
+    if (std::abs(a.x - b.right()) < kEps) return 1;
+    if (std::abs(a.top() - b.y) < kEps) return 2;
+    if (std::abs(a.right() - b.x) < kEps) return 3;
+    return 4;
