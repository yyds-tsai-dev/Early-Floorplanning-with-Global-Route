+        assert(r1.routes[i].node_path == r2.routes[i].node_path);
+    }
+    assert(std::abs(r1.channel_overflow - r2.channel_overflow) < kEps);
+    assert(std::abs(r1.feedthrough_mismatch - r2.feedthrough_mismatch) < kEps);
