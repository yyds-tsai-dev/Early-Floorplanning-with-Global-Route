+    p.block_index = {{"A", 0}, {"B", 1}, {"R", 2}};
+    p.outline_w = 150;
+    p.outline_h = 300;
+    p.alpha = 1.0;
+    Bundle bun;
+    bun.source = 0;
+    bun.target = 1;
